# Set up logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Device configuration
if torch.cuda.is_available():
    device = torch.device("cuda")
    logger.info(f"Using GPU: {torch.cuda.get_device_name(0)}")
elif torch.backends.mps.is_available():  # For Apple Silicon
    device = torch.device("mps")
    logger.info("Using Apple MPS device")
else:
    device = torch.device("cpu")
    logger.info("Using CPU")
logger.info(f"Using device: {device}")

# Load Depth Anything V2 model using Hugging Face pipeline
try:
    print("🔄 Loading Depth Anything V2 model...")

    depth_estimator = pipeline(
        task="depth-estimation",
        model="depth-anything/Depth-Anything-V2-Small-hf",
        device=0 if torch.cuda.is_available() else -1,
        torch_dtype=torch.float16 if torch.cuda.is_available() else torch.float32
    )

    print("✅ Depth Anything V2 Small loaded successfully")

    class DepthModelWrapper:
        def __init__(self, pipeline_model):
            self.pipeline = pipeline_model
            self.device = device
            self.eval_mode = True

        def eval(self):
            self.eval_mode = True
            return self

        def to(self, device):
            self.device = device
            return self

        def infer_image(self, image):
            if isinstance(image, np.ndarray):
                if image.shape[2] == 3:  # BGR to RGB
                    image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
                image = Image.fromarray(image)

            results = self.pipeline(image)
            depth_map = results["depth"]
            depth_array = np.array(depth_map)
            return depth_array

        def __call__(self, image_tensor):
            if isinstance(image_tensor, torch.Tensor):
                image_np = image_tensor.squeeze().cpu().numpy()
                if image_np.shape[0] == 3:  # CHW to HWC
                    image_np = image_np.transpose(1, 2, 0)
                image_np = (image_np * 255).astype(np.uint8)
                image_pil = Image.fromarray(image_np)
                return self.infer_image(image_pil)
            return self.infer_image(image_tensor)

    depth_model = DepthModelWrapper(depth_estimator)
    depth_model.to(device)
    depth_model.eval()
    transform = None
    logger.info("Depth Anything V2 Small model loaded successfully via Hugging Face")

except Exception as e:
    logger.error(f"Failed to load Depth Anything V2 model via Hugging Face: {e}")
    import traceback
    logger.error(traceback.format_exc())
    depth_model = None
    transform = None

# Fallback to MiDaS if Depth Anything is not available
if depth_model is None:
    try:
        logger.info("Falling back to MiDaS model...")
        midas = torch.hub.load("intel-isl/MiDaS", "DPT_Hybrid")
        midas.to(device)
        midas.eval()
        midas_transforms = torch.hub.load("intel-isl/MiDaS", "transforms")
        midas_transform = midas_transforms.dpt_transform
        logger.info("MiDaS model loaded as fallback")
    except Exception as e:
        logger.error(f"Failed to load MiDaS model: {e}")
        raise

def check_ffmpeg():
    try:
        subprocess.run(["ffmpeg", "-version"], capture_output=True, check=True)
        return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False

if not check_ffmpeg():
    logger.error("ffmpeg is not installed. Video processing will fail.")
    raise RuntimeError("ffmpeg is required for video processing")

def run_command(cmd, description):
    """Run a command with error handling"""
    try:
        logger.info(f"{description}: {' '.join(cmd)}")
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
        return True
    except subprocess.CalledProcessError as e:
        logger.error(f"{description} failed: {e.stderr}")
        return False

def inject_proper_vr180_metadata(input_video, output_video):
    metadata_cmd = [
        "ffmpeg", "-y", "-i", input_video,
        "-movflags", "use_metadata_tags",
        "-metadata", "spherical=true",
        "-metadata", "stereo-mode=left-right",
        "-metadata", "projection-type=equidistant-fisheye",
        "-metadata", "com.google.vr.spherical=true",
        "-metadata", "com.google.vr.stereo-mode=left-right",
        "-metadata", "com.google.vr.projection-type=equidistant-fisheye",
        "-metadata", "com.google.vr.capture-motion=true",
        "-c", "copy",
        output_video
    ]

    if run_command(metadata_cmd, "Injecting VR180 metadata"):
        return True

    temp_metadata_file = os.path.join(tempfile.gettempdir(), f"vr180_metadata_{uuid.uuid4().hex}.txt")
    with open(temp_metadata_file, 'w') as f:
        f.write(";FFMETADATA1\n")
        f.write("spherical=true\n")
        f.write("stereo-mode=left-right\n")
        f.write("projection-type=equidistant-fisheye\n")
        f.write("com.google.vr.spherical=true\n")
        f.write("com.google.vr.stereo-mode=left-right\n")
        f.write("com.google.vr.projection-type=equidistant-fisheye\n")

    metadata_cmd_2 = [
        "ffmpeg", "-y", "-i", input_video,
        "-i", temp_metadata_file,
        "-map_metadata", "1",
        "-movflags", "use_metadata_tags",
        "-c", "copy",
        output_video
    ]

    try:
        result = run_command(metadata_cmd_2, "Injecting VR180 metadata with file")
        os.remove(temp_metadata_file)
        return result
    except:
        if os.path.exists(temp_metadata_file):
            os.remove(temp_metadata_file)
        return False

def estimate_depth(frame):
    """Estimate depth using Depth Anything V2 or MiDaS fallback with improved normalization"""
    if depth_model is not None:
        try:
            depth_map = depth_model.infer_image(frame)
            if depth_map.max() - depth_map.min() > 1e-10:
                depth_map = (depth_map - depth_map.min()) / (depth_map.max() - depth_map.min())
            else:
                depth_map = np.ones_like(depth_map) * 0.5
            depth_map = cv2.GaussianBlur(depth_map, (3, 3), 0.5)
            return depth_map
        except Exception as e:
            logger.error(f"Depth Anything V2 inference failed: {e}")

    # Fallback to MiDaS
    try:
        frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        input_batch = midas_transform(frame_rgb).to(device)
        with torch.no_grad():
            depth = midas(input_batch)
            depth = depth.squeeze().cpu().numpy()
        if depth.max() - depth.min() > 1e-10:
            depth_norm = (depth - depth.min()) / (depth.max() - depth.min())
        else:
            depth_norm = np.ones_like(depth) * 0.5
        depth_norm = cv2.GaussianBlur(depth_norm, (3, 3), 0.5)
        return depth_norm
    except Exception as e:
        logger.error(f"MiDaS inference also failed: {e}")
        # Reasonable default gradient
        h, w = frame.shape[:2]
        y_coords, x_coords = np.indices((h, w))
        center_x, center_y = w // 2, h // 2
        depth_x = 1 - np.abs(x_coords - center_x) / center_x
        depth_y = 1 - np.abs(y_coords - center_y) / center_y
        depth = (depth_x + depth_y) / 2
        return depth

def generate_stereo_pair(frame, depth_map, ipd=63, disparity_cap=1.5):
    """Generate left and right views with capped disparity and improved occlusion handling"""
    h, w = frame.shape[:2]
    # compute subpixel disparity as float map
    max_disparity = (w * (disparity_cap / 90.0))  # may be fractional
    disparity_map = depth_map * max_disparity

    # Build remap coordinate grids for left and right (horizontal shifts)
    y_coords = np.arange(h).astype(np.float32)
    x_coords = np.arange(w).astype(np.float32)
    map_x, map_y = np.meshgrid(x_coords, y_coords)

    # Right view: sample from x + disparity (objects closer shift more horizontally)
    map_x_right = (map_x - disparity_map).astype(np.float32)
    map_y_right = map_y.astype(np.float32)
    # Left view: sample from x + disparity (opposite direction)
    map_x_left = (map_x + disparity_map).astype(np.float32)
    map_y_left = map_y.astype(np.float32)

    # clamp but allow border wrap horizontally to avoid seams
    left_view = cv2.remap(frame, map_x_left, map_y_left, interpolation=cv2.INTER_LINEAR,
                          borderMode=cv2.BORDER_REPLICATE)
    right_view = cv2.remap(frame, map_x_right, map_y_right, interpolation=cv2.INTER_LINEAR,
                           borderMode=cv2.BORDER_REPLICATE)

    # Inpainting occluded holes (simple mask + telea)
    # Detect holes by comparing where remap sampled outside original bounds -> produce slight artifacts, so detect black pixels
    left_view = improved_inpaint_occlusions(left_view, frame, -disparity_map)
    right_view = improved_inpaint_occlusions(right_view, frame, disparity_map)

    return left_view, right_view

def improved_inpaint_occlusions(shifted_view, original_frame, disparity_map):
    """Improved inpainting for occlusions using content-aware filling"""
    # Mask where the remap created black (or near black) areas
    # Convert to gray then threshold
    gray = cv2.cvtColor(shifted_view, cv2.COLOR_BGR2GRAY)
    mask = (gray < 5).astype(np.uint8) * 255

    if np.sum(mask) > 0:
        # Use TELEA inpainting (fast & decent)
        result = cv2.inpaint(shifted_view, mask, 5, cv2.INPAINT_TELEA)
        blend_mask = (mask.astype(np.float32) / 255.0)[..., None]
        result = result * (1 - blend_mask) + original_frame * blend_mask
        return result.astype(np.uint8)
    return shifted_view

def enhanced_panini_projection(image, d=1e6, blend_stereographic=0.0, fov_expansion=1.4):
    """
    Enhanced Panini projection implemented with cv2.remap to avoid integer assignment holes
    and with proper horizontal wrap handling to reduce seam lines.
    """
    h, w = image.shape[:2]

    # Expand horizontally for peripheral outpainting
    expanded_w = int(round(w * fov_expansion))
    # ensure expanded_w >= w and odd/even consistent
    if expanded_w <= w:
        expanded_w = w + 2
    expanded_image = np.zeros((h, expanded_w, 3), dtype=np.uint8)
    start_x = (expanded_w - w) // 2
    expanded_image[:, start_x:start_x + w] = image

    # Outpaint edges (simple content-aware fill approximation)
    expanded_image = improved_ai_outpainting(expanded_image, start_x, w)

    new_h, new_w = expanded_image.shape[:2]

    # Build normalized coordinate grids centered at 0
    ys = np.linspace(-1.0, 1.0, new_h).astype(np.float32)
    xs = np.linspace(-1.0, 1.0, new_w).astype(np.float32)
    x_n, y_n = np.meshgrid(xs, ys)

    # avoid division by zero
    eps = 1e-9
    d = max(1e-3, float(d))

    # Panini mapping (formulas vectorized)
    atan_xn_d = np.arctan(x_n / d)
    cos_ax = np.cos(atan_xn_d)
    sin_ax = np.sin(atan_xn_d)
    denom = cos_ax + (y_n * sin_ax) / d
    denom = np.where(np.abs(denom) < eps, eps, denom)
    y_p = y_n / denom
    x_p = x_n.copy()

    # Stereographic blend
    if blend_stereographic > 0:
        r = np.sqrt(x_n ** 2 + y_n ** 2)
        theta = np.arctan2(y_n, x_n)
        # stereographic r_s: careful with r near 0
        r_s = 2.0 * np.tan(r / 2.0 + eps)
        x_s = r_s * np.cos(theta)
        y_s = r_s * np.sin(theta)
        x_p = (1 - blend_stereographic) * x_p + blend_stereographic * x_s
        y_p = (1 - blend_stereographic) * y_p + blend_stereographic * y_s

    # Now convert projected normalized coords back to pixel coords (float)
    map_x = ((x_p + 1.0) * (new_w - 1) / 2.0).astype(np.float32)
    map_y = ((y_p + 1.0) * (new_h - 1) / 2.0).astype(np.float32)

    # Use remap (interpolation) to avoid holes. Use replicate borders vertically and wrap horizontally to reduce seams.
    # But cv2.remap doesn't have BORDER_WRAP for x separately, so we will handle wrap manually:
    # First pad horizontally by wrap and then remap inside padded region to allow sample from circular domain.
    pad = 2  # small pad to allow wrap sampling
    padded = np.concatenate([expanded_image[:, -pad:], expanded_image, expanded_image[:, :pad]], axis=1)
    # adjust map_x to account for pad
    map_x_padded = map_x + pad

    # remap into padded image; use linear interpolation and replicate borders vertically
    remapped = cv2.remap(padded, map_x_padded, map_y, interpolation=cv2.INTER_LINEAR,
                         borderMode=cv2.BORDER_REPLICATE)

    # Seam reduction: compute angles and blur selectively where requested
    center_x, center_y = (new_w - 1) / 2.0, (new_h - 1) / 2.0
    X_coords, Y_coords = np.meshgrid(np.arange(new_w), np.arange(new_h))
    angles = (np.degrees(np.arctan2(Y_coords - center_y, X_coords - center_x)) + 360.0) % 360.0

    # invisible_mask for 0-90 and 180-270 (vectorized)
    invisible_mask = ((angles >= 0) & (angles <= 90)) | ((angles >= 180) & (angles <= 270))
    invisible_mask = invisible_mask.astype(np.uint8)

    # Create a small blurred version and blend only where mask==1
    if invisible_mask.sum() > 0:
        blurred = cv2.GaussianBlur(remapped, (7, 7), 3.0)
        mask3 = invisible_mask[..., None].astype(np.float32)
        remapped = (remapped.astype(np.float32) * (1 - mask3) + blurred.astype(np.float32) * mask3).astype(np.uint8)

    # Final gentle seam smoothing
    remapped = cv2.GaussianBlur(remapped, (3, 3), 0.8)
    remapped = cv2.edgePreservingFilter(remapped, flags=1, sigma_s=10, sigma_r=0.15)

    # Crop back to original width
    crop_start = start_x
    cropped_output = remapped[:, crop_start:crop_start + w]


    return cropped_output



def improved_ai_outpainting(image, center_start, center_width):
    """
    Improved AI outpainting simulation for peripheral areas
    Uses more context and better blending for seamless expansion
    """
    h, w, _ = image.shape

    # Left side outpainting
    if center_start > 0:
        left_context_width = min(30, center_width)
        left_context = image[:, center_start:center_start + left_context_width].astype(np.float32)
        blend_gradient = np.linspace(1.0, 0.5, center_start)[:, np.newaxis, np.newaxis]
        for x in range(center_start):
            weights = np.array([0.5, 0.3, 0.2])
            blended_column = np.zeros((h, 3), dtype=np.float32)
            for i, weight in enumerate(weights):
                if i < left_context.shape[1]:
                    blended_column += left_context[:, i] * weight
            image[:, x] = (blended_column * blend_gradient[x] + image[:, x].astype(np.float32) * (1 - blend_gradient[x])).astype(np.uint8)

    # Right side outpainting
    right_start = center_start + center_width
    if right_start < w:
        right_context_width = min(30, center_width)
        right_context = image[:, max(0, right_start - right_context_width):right_start].astype(np.float32)
        blend_gradient = np.linspace(0.5, 1.0, w - right_start)[:, np.newaxis, np.newaxis]
        for i, x in enumerate(range(right_start, w)):
            weights = np.array([0.2, 0.3, 0.5])
            blended_column = np.zeros((h, 3), dtype=np.float32)
            for j, weight in enumerate(weights):
                col_idx = right_context.shape[1] - 1 - j
                if col_idx >= 0:
                    blended_column += right_context[:, col_idx] * weight
            image[:, x] = (blended_column * blend_gradient[i] + image[:, x].astype(np.float32) * (1 - blend_gradient[i])).astype(np.uint8)

    return image

def log_polar_foveated_blur(image, blur_start_deg=70, max_sigma=18):
    """
    Updated foveated blur with blur starting further from center
    """
    h, w = image.shape[:2]
    center_x, center_y = w // 2, h // 2

    x = (np.arange(w) - center_x) / center_x * 90.0
    y = (np.arange(h) - center_y) / center_y * 90.0
    xx, yy = np.meshgrid(x, y)
    distance = np.sqrt(xx**2 + yy**2)

    t = np.clip((distance - (blur_start_deg * 0.8)) / (blur_start_deg * 0.2 + 1e-6), 0.0, 1.0)
    falloff = (np.log1p(t * 7) / np.log1p(7)).astype(np.float32)

    sigmas = [0.0, max(1, min(5, max_sigma / 4)), max(6, min(10, max_sigma / 2)), max(12, max_sigma)]
    blurred_versions = []
    for s in sigmas:
        if s <= 0.001:
            blurred_versions.append(image.astype(np.float32))
        else:
            k = int(2 * round(3 * s) + 1)
            if k <= 1:
                blurred_versions.append(image.astype(np.float32))
            else:
                blurred_versions.append(cv2.GaussianBlur(image, (k, k), sigmaX=s).astype(np.float32))

    levels = np.array([0.0, 0.33, 0.66, 1.0], dtype=np.float32)
    output = np.zeros_like(image, dtype=np.float32)
    for i in range(len(levels) - 1):
        denom = (levels[i+1] - levels[i]) if (levels[i+1] - levels[i]) != 0 else 1e-6
        mask = np.clip((falloff - levels[i]) / denom, 0.0, 1.0)[..., None]
        output += blurred_versions[i] * (1 - mask) + blurred_versions[i+1] * mask

    zero_mask = (falloff <= 0).astype(np.float32)[..., None]
    output = output * (1 - zero_mask) + image.astype(np.float32) * zero_mask

    return np.clip(output, 0, 255).astype(np.uint8)

def enhanced_process_video_frame(frame):
    """Enhanced processing pipeline with all Round 2 requirements (no baked fisheye)"""
    depth_map = estimate_depth(frame)
    left_view, right_view = generate_stereo_pair(frame, depth_map)
    left_panini = enhanced_panini_projection(left_view, d=1e6, blend_stereographic=0.0, fov_expansion=1.4)
    right_panini = enhanced_panini_projection(right_view, d=1e6, blend_stereographic=0.0, fov_expansion=1.4)
    left_blurred = log_polar_foveated_blur(left_panini, blur_start_deg=70, max_sigma=18)
    right_blurred = log_polar_foveated_blur(right_panini, blur_start_deg=70, max_sigma=18)
    stereo_frame = np.concatenate((left_blurred, right_blurred), axis=1)
    return stereo_frame

def optimized_panini_projection(image):
    # Simple faster panini fallback - keep original image for now
    return image

def create_equidistant_fisheye(pair):
    # placeholder to convert to fisheye; pass-through for now
    return pair

def optimized_process_video_frame(frame):
    depth_map = estimate_depth(frame)
    left_view, right_view = generate_stereo_pair(frame, depth_map)
    left_panini = optimized_panini_projection(left_view)
    right_panini = optimized_panini_projection(right_view)
    left_blurred = log_polar_foveated_blur(left_panini)
    right_blurred = log_polar_foveated_blur(right_panini)
    left_fisheye, right_fisheye = create_equidistant_fisheye((left_blurred, right_blurred))
    stereo_frame = np.concatenate((left_fisheye, right_fisheye), axis=1)
    return stereo_frame

def convert_video_to_vr180(input_path, output_path, use_enhanced=True):
    """Convert a standard video to VR180 format with enhanced Round 2 features"""
    temp_dir = tempfile.mkdtemp()
    try:
        audio_path = os.path.join(temp_dir, "audio.aac")
        extract_audio_cmd = [
            "ffmpeg", "-y", "-i", input_path,
            "-vn", "-acodec", "copy", audio_path
        ]
        run_command(extract_audio_cmd, "Extracting audio")

        # Get frame rate robustly using ffprobe
        probe_cmd = [
            "ffprobe", "-v", "error", "-select_streams", "v:0",
            "-show_entries", "stream=r_frame_rate", "-of", "default=noprint_wrappers=1:nokey=1", input_path
        ]
        result = subprocess.run(probe_cmd, capture_output=True, text=True)
        frame_rate_val = result.stdout.strip()
        try:
            if '/' in frame_rate_val:
                num, den = frame_rate_val.split('/')
                frame_rate = float(num) / float(den)
            else:
                frame_rate = float(frame_rate_val)
            if frame_rate <= 0 or not np.isfinite(frame_rate):
                frame_rate = 30.0
        except:
            frame_rate = 30.0

        # Extract frames deterministically at the detected fps (ensures correct frame count)
        frame_pattern = os.path.join(temp_dir, "frame_%06d.png")
        extract_cmd = [
            "ffmpeg", "-y", "-i", input_path,
            "-vf", f"fps={frame_rate}",
            frame_pattern
        ]
        if not run_command(extract_cmd, "Extracting frames with fixed fps"):
            raise Exception("Failed to extract frames")

        frame_files = sorted([f for f in os.listdir(temp_dir) if f.startswith("frame_") and f.endswith(".png")])
        total_frames = len(frame_files)
        logger.info(f"Found {total_frames} frames to process (fps={frame_rate})")

        for i, frame_file in enumerate(frame_files):
            frame_path = os.path.join(temp_dir, frame_file)
            frame = cv2.imread(frame_path)

            if frame is not None:
                if use_enhanced:
                    processed_frame = enhanced_process_video_frame(frame)
                else:
                    processed_frame = optimized_process_video_frame(frame)

                # Ensure we save as same type and valid uint8
                if processed_frame.dtype != np.uint8:
                    processed_frame = np.clip(processed_frame, 0, 255).astype(np.uint8)

                # If processed frame has different size, resize to keep all frames uniform
                orig_h, orig_w = frame.shape[:2]
                proc_h, proc_w = processed_frame.shape[:2]
                # We allow stereo output (double width). If dimensions differ vertically, resize to match original height.
                if proc_h != orig_h:
                    processed_frame = cv2.resize(processed_frame, (processed_frame.shape[1], orig_h), interpolation=cv2.INTER_AREA)

                cv2.imwrite(frame_path, processed_frame)

            # Log more sensibly
            if (i + 1) % 10 == 0 or (i + 1) == total_frames:
                logger.info(f"Processed frame {i+1}/{total_frames}")
                print(f"Processed frame {i+1}/{total_frames}")

        # Reconstruct video from processed frames with original frame rate - use -framerate for image sequences
        temp_output = os.path.join(temp_dir, "temp_vr180.mp4")
        reconstruct_cmd = [
            "ffmpeg", "-y", "-framerate", str(frame_rate), "-i", os.path.join(temp_dir, "frame_%06d.png"),
            "-c:v", "libx264", "-preset", "medium", "-crf", "18", "-pix_fmt", "yuv420p",
            temp_output
        ]
        if not run_command(reconstruct_cmd, "Reconstructing video from frames"):
            raise Exception("Failed to reconstruct video")

        # Merge audio with video
        temp_with_audio = os.path.join(temp_dir, "vr180_with_audio.mp4")
        merge_audio_cmd = [
            "ffmpeg", "-y", "-i", temp_output, "-i", audio_path,
            "-c", "copy", "-map", "0:v:0", "-map", "1:a:0",
            temp_with_audio
        ]
        if not run_command(merge_audio_cmd, "Merging audio"):
            raise Exception("Failed to merge audio")

        # Upscale if needed
        upscaled_output = os.path.join(temp_dir, "upscaled_vr180.mp4")
        if not upscale_video(temp_with_audio, upscaled_output, target_res=(7680, 3840)):
            raise Exception("Failed to upscale video")

        # Inject PROPER VR180 metadata (using the new enhanced function)
        if not inject_proper_vr180_metadata(upscaled_output, output_path):
            raise Exception("Failed to inject VR180 metadata")

        logger.info(f"Successfully converted video to VR180: {output_path}")
        return True

    except Exception as e:
        logger.error(f"Video conversion failed: {e}")
        import traceback
        logger.error(traceback.format_exc())
        return False
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)

def upscale_video(input_path, output_path, target_res=(7680, 3840)):
    """Upscale video to target resolution"""
    cmd = [
        "ffmpeg", "-y", "-i", input_path,
        "-vf", f"scale={target_res[0]}:{target_res[1]}",
        "-c:v", "libx264", "-preset", "medium", "-crf", "23",
        output_path
    ]
    return run_command(cmd, "Upscaling video")

def main():
    """Main function to run the VR180 conversion"""
    input_video = "/content/inception10sec.mp4"  # Replace with your input video path
    output_video = "/content/out_with_rectiliner_vr180-1sec.mp4"  # Replace with your desired output path

    if not os.path.exists(input_video):
        logger.error(f"Input video not found: {input_video}")
        return

    logger.info(f"Starting VR180 conversion for: {input_video}")
    success = convert_video_to_vr180(input_video, output_video, use_enhanced=True)

    if success:
        logger.info(f"Conversion completed successfully: {output_video}")
        print(f"✅ VR180 conversion complete! Output: {output_video}")
    else:
        logger.error("Conversion failed")
        print("❌ Conversion failed")

